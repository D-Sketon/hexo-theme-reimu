<%_ if (post.prev || post.next) { _%>
  <nav id="article-nav" aria-label="Article navigation" data-aos="<%= theme.animation.options.article.nav %>">
    <%_ const navItems = [
      { post: post.prev, side: 'left', caption: __('newer') },
      { post: post.next, side: 'right', caption: __('older') }
    ]; _%>
    <%_ navItems.forEach((item) => { _%>
      <%_ const navPost = item.post; _%>
      <%_ if (!navPost) return; _%>
      <%_ const postByLang = get_post_by_lang(navPost.permalink, post.lang); _%>
      <div class="article-nav-link-wrap <%= item.side %>">
        <%_ if (navPost.cover && !navPost.cover.startsWith('rgb')) { _%>
          <img data-src="<%- url_for(navPost.cover, {relative: false}) %>" data-sizes="auto" alt="<%= postByLang.title %>" class="lazyload">
        <%_ } else { _%>
          <%_ let cover = randomCover(); _%>
          <%_ if (cover) { _%>
            <img data-src="<%= cover %>" data-sizes="auto" alt="<%= postByLang.title %>" class="lazyload">
          <%_ } else { _%>
            <img data-src="<%- url_for(theme.banner, {relative: false}) %>" data-sizes="auto" alt="<%= postByLang.title %>" class="lazyload">
          <%_ } _%>
        <%_ } _%>
        <a href="<%- url_for_lang(navPost.path, {relative: false}) %>" aria-label="<%= item.caption %>: <%= postByLang.title || 'no title' %>" title="<%= item.caption %>: <%= postByLang.title || 'no title' %>"></a>
        <div class="article-nav-caption"><%= item.caption %></div>
        <h3 class="article-nav-title">
          <%_ if (postByLang.title) { _%>
            <%= postByLang.title %>
          <%_ } else { _%>
            (no title)
          <%_ } _%>
        </h3>
      </div>
    <%_ }) _%>
  </nav>
<%_ } _%>
